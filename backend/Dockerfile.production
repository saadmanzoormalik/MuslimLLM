FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN groupadd --system --gid 10001 muslimllm \
    && useradd --system --uid 10001 --gid muslimllm --home-dir /app --shell /usr/sbin/nologin muslimllm

WORKDIR /app
COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.txt

COPY --chown=muslimllm:muslimllm backend/app /app/app
COPY --chown=muslimllm:muslimllm data /app/data
COPY --chown=muslimllm:muslimllm evals /app/evals
COPY --chown=muslimllm:muslimllm postgres /app/postgres
COPY --chown=muslimllm:muslimllm muslim_llm_system_prompt.md /app/muslim_llm_system_prompt.md

RUN python -m compileall -q /app/app \
    && mkdir -p /app/data/uploads /app/data/context-imports /app/data/updates \
    && chown -R muslimllm:muslimllm /app/data

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).read()"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
